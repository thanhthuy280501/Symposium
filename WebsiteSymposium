<style>
:root{
  --navy:#0b2340; --navy-2:#13335a; --maize:#f2c230; --ink:#1c2533; --muted:#5a6577;
  --bg:#fbfaf7; --card:#ffffff; --line:#e6e2d8; --soft:#f3efe4;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,system-ui,sans-serif;color:var(--ink);background:var(--bg);line-height:1.6;font-size:17px}
a{color:var(--navy-2)}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:Fraunces,Georgia,serif;line-height:1.15;margin:0}
h2{font-size:clamp(1.8rem,3.5vw,2.4rem);color:var(--navy)}
.eyebrow{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--muted);margin-bottom:10px}

/* nav */
nav{position:sticky;top:0;z-index:10;background:rgba(11,35,64,.97);backdrop-filter:blur(6px)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:60px;gap:16px}
nav .brand{color:#fff;font-weight:600;text-decoration:none;font-size:.95rem;white-space:nowrap}
nav .brand span{color:var(--maize)}
nav ul{list-style:none;display:flex;gap:22px;margin:0;padding:0}
nav ul a{color:#dfe6f0;text-decoration:none;font-size:.9rem}
nav ul a:hover{color:var(--maize)}
@media (max-width:760px){nav ul{display:none}}

/* hero */
header.hero{background:radial-gradient(1200px 500px at 85% -10%,#1d4a7c 0%,transparent 60%),var(--navy);color:#fff;padding:90px 0 80px;overflow:hidden;position:relative}
.hero .eyebrow{color:var(--maize)}
.hero h1{font-size:clamp(2.4rem,6vw,4.2rem);max-width:14ch}
.hero p.lead{font-size:clamp(1.05rem,2vw,1.25rem);color:#d5deea;max-width:58ch;margin:22px 0 34px}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.15);border-radius:12px;overflow:hidden;max-width:820px}
.facts div{background:var(--navy);padding:16px 18px}
.facts b{display:block;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--maize);font-weight:600;margin-bottom:4px}
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.btn{display:inline-block;padding:13px 22px;border-radius:999px;font-weight:600;text-decoration:none;font-size:.95rem}
.btn.primary{background:var(--maize);color:var(--navy)}
.btn.ghost{border:1px solid rgba(255,255,255,.4);color:#fff}
.btn:hover{transform:translateY(-1px)}

section{padding:80px 0}
section.alt{background:var(--soft)}
.two{display:grid;grid-template-columns:1fr 1.4fr;gap:48px;align-items:start}
@media (max-width:820px){.two{grid-template-columns:1fr;gap:20px}}
.prose p{margin:0 0 16px}

/* goals */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-top:36px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:24px}
.card h3{font-size:1.2rem;color:var(--navy);margin-bottom:8px}
.card p{margin:0;color:var(--muted);font-size:.97rem}
.num{font-family:Fraunces,serif;color:var(--maize);font-size:1.6rem;font-weight:700;line-height:1;margin-bottom:12px;-webkit-text-stroke:.5px var(--navy)}

/* program */
.program{margin-top:36px;border-left:2px solid var(--line);padding-left:0}
.item{position:relative;padding:0 0 30px 34px}
.item::before{content:"";position:absolute;left:-8px;top:6px;width:14px;height:14px;border-radius:50%;background:var(--maize);border:3px solid var(--bg)}
.alt .item::before{border-color:var(--soft)}
.item h3{font-size:1.25rem;color:var(--navy)}
.tag{display:inline-block;font-family:Inter,sans-serif;font-size:.7rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;background:var(--navy);color:#fff;padding:3px 9px;border-radius:999px;margin-left:8px;vertical-align:middle}
.item p{margin:6px 0 0;color:var(--muted);max-width:68ch}
.item ul{margin:10px 0 0;padding-left:20px;color:var(--muted)}
.note{background:var(--card);border:1px dashed #c9c1ad;border-radius:12px;padding:16px 20px;color:var(--muted);font-size:.95rem;margin-top:10px}

/* audience */
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.chip{background:var(--card);border:1px solid var(--line);padding:9px 15px;border-radius:999px;font-size:.93rem}

/* people */
.people{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-top:32px}
.person .role{font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:600}
.person h3{font-size:1.15rem;color:var(--navy);margin:6px 0 4px}
.person a{font-size:.92rem;word-break:break-all}

footer{background:var(--navy);color:#b9c5d6;padding:36px 0;font-size:.9rem}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px}
</style>
